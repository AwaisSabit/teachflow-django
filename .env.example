# Copy this file to .env and fill in your own values. Never commit .env.
# .env is ignored by git — only this example is tracked.

# Required in production. In dev a clearly-marked unsafe default is used.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave DATABASE_URL unset for local SQLite dev.
# For PostgreSQL, set one of:
#   DATABASE_URL=postgres://teachflow:password@localhost:5432/teachflow
#   or the POSTGRES_* variables below.
# DATABASE_URL=
# POSTGRES_DB=teachflow
# POSTGRES_USER=teachflow
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email (production): password reset needs a mail server. With the
# default SMTP backend, DJANGO_EMAIL_HOST is required — production
# refuses to start without it. Set DJANGO_EMAIL_BACKEND to
# django.core.mail.backends.console.EmailBackend instead when no real
# mail server is available (for example a test deployment).
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# Set DJANGO_BEHIND_PROXY=True only when a reverse proxy you control
# sits in front of the app and strips X-Forwarded-Proto from outside
# traffic. Without it, HTTPS redirects loop behind a proxy.
# DJANGO_BEHIND_PROXY=False
